# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
PUBLIC_ORIGIN=http://localhost

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=myflix
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=myflix
DATABASE_URL=postgresql://myflix:change-me-postgres@postgres:5432/myflix?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ─── MinIO / S3 ──────────────────────────────────────────────────────────────
MINIO_ROOT_USER=myflix
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=myflix
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true
BUCKET_SOURCE=myflix-source
BUCKET_MEDIA=myflix-media
BUCKET_IMAGES=myflix-images
BUCKET_STAGING=myflix-staging

# ─── Auth (ADR: access 15m / refresh 30d rotation) ───────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=2592000
ALLOW_REGISTRATION=true
ADMIN_EMAIL=admin@myflix.local
ADMIN_PASSWORD=change-me-admin-password

# ─── Signed media URL (shared with nginx secure_link, ADR-006) ───────────────
# MUST be identical to `secure_link_secret` in infra/nginx/conf.d/myflix.conf
MEDIA_SIGNING_SECRET=change-me-media-secret
MEDIA_URL_TTL_SEC=14400

# ─── Ingest ──────────────────────────────────────────────────────────────────
UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_URL_TTL_SEC=3600

# ─── Transcoder (ADR-005: NVENC session limit forces concurrency 1) ──────────
TRANSCODE_CONCURRENCY=1
TRANSCODE_ENCODER=h264_nvenc
TRANSCODE_PRESET=p5
TRANSCODE_SEGMENT_SEC=4
TRANSCODE_TIMEOUT_SEC=14400
FFMPEG_BIN=/usr/local/bin/ffmpeg
FFPROBE_BIN=/usr/local/bin/ffprobe

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=/api
API_INTERNAL_URL=http://api:4000
