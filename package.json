{
  "name": "myflix",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @myflix/db generate",
    "db:migrate": "pnpm --filter @myflix/db migrate",
    "db:seed": "pnpm --filter @myflix/db seed",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "verify:phase0": "bash scripts/verify-phase0.sh",
    "test:e2e": "pnpm --filter @myflix/api test:e2e && pnpm --filter @myflix/e2e test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "@node-rs/argon2"
    ]
  }
}
