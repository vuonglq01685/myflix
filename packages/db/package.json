{
  "name": "@myflix/db",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node dist/seed.js",
    "test": "echo 'no unit tests in @myflix/db (covered by integration tests)'"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "@myflix/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.2.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
