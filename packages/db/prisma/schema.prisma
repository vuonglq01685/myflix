// MyFlix data model — mirrors doc 04 (Data Model).
//
// Prisma cannot express CHECK constraints, partial indexes, GENERATED
// columns or table partitioning. Those live in the hand-written migration at
// prisma/migrations/20260908000000_init/migration.sql, which is the
// authoritative DDL. This file exists so the generated client is typed.
//
// The two are kept in lockstep, and that is checkable — this must print
// "empty migration":
//
//   prisma migrate diff --from-url "$DATABASE_URL" \
//     --to-schema-datamodel prisma/schema.prisma --script
//
// Use `prisma migrate deploy`. Never `migrate dev` against a database with
// data: it would try to "repair" the CHECK constraints and partial indexes it
// cannot see.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  VIEWER
  ADMIN

  @@map("user_role")
}

enum TitleType {
  MOVIE
  SERIES

  @@map("title_type")
}

enum TitleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("title_status")
}

enum AssetKind {
  MOVIE
  EPISODE
  TRAILER

  @@map("asset_kind")
}

/// Exactly one terminal state (READY) allows playback. See HLD §5.2.
enum AssetStatus {
  UPLOADING
  QUEUED
  PROBING
  ENCODING
  PACKAGING
  COMMITTING
  READY
  FAILED

  @@map("asset_status")
}

enum SubtitleKind {
  SUBTITLES
  CAPTIONS
  FORCED

  @@map("subtitle_kind")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("job_status")
}

// ─── Accounts ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profiles Profile[]

  @@map("users")
}

model Profile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  name             String   @db.VarChar(50)
  avatarKey        String?  @map("avatar_key")
  isKids           Boolean  @default(false) @map("is_kids")
  language         String   @default("vi") @db.VarChar(10)
  autoplayNext     Boolean  @default(true) @map("autoplay_next")
  autoplayPreviews Boolean  @default(true) @map("autoplay_previews")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progress WatchProgress[]
  myList   MyListItem[]

  @@unique([userId, name], map: "uq_profile_name_per_user")
  @@index([userId], map: "idx_profiles_user")
  @@map("profiles")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Title {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           TitleType
  status         TitleStatus @default(DRAFT)
  name           String      @db.VarChar(255)
  originalName   String?     @map("original_name") @db.VarChar(255)
  synopsis       String?
  releaseYear    Int?        @map("release_year") @db.SmallInt
  maturityRating String?     @map("maturity_rating") @db.VarChar(10)
  posterKey      String?     @map("poster_key")
  backdropKey    String?     @map("backdrop_key")
  logoKey        String?     @map("logo_key")
  /// No FK: the trailer asset points back at this title, so a real FK
  /// would be circular. Integrity is enforced in the ingest service.
  trailerAssetId String?     @map("trailer_asset_id") @db.Uuid
  /// [{ name, character, order }] — no query-by-actor need in v1 (doc 04 §3.3).
  castMembers    Json        @default("[]") @map("cast_members")
  directors      Json        @default("[]")
  publishedAt    DateTime?   @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// GENERATED ALWAYS column, weights A/B/C, 'simple' config (ADR-011).
  searchVector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  seasons Season[]
  genres  TitleGenre[]
  assets  MediaAsset[]
  myList  MyListItem[]

  @@index([status, publishedAt(sort: Desc)], map: "idx_titles_status_published")
  @@index([searchVector(ops: raw("tsvector_ops"))], type: Gin, map: "idx_titles_search")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_titles_name_trgm")
  @@map("titles")
}

model Season {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleId   String   @map("title_id") @db.Uuid
  number    Int      @db.SmallInt
  name      String?  @db.VarChar(100)
  synopsis  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  title    Title     @relation(fields: [titleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  episodes Episode[]

  @@unique([titleId, number], map: "uq_season_number")
  @@index([titleId, number], map: "idx_seasons_title")
  @@map("seasons")
}

model Episode {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId String  @map("season_id") @db.Uuid
  number   Int     @db.SmallInt
  name     String  @db.VarChar(255)
  synopsis String?
  stillKey String? @map("still_key")

  /// NULL markers simply hide Skip Intro / Next Episode (HLD §7.3).
  introStartSec   Int?      @map("intro_start_sec")
  introEndSec     Int?      @map("intro_end_sec")
  creditsStartSec Int?      @map("credits_start_sec")
  airDate         DateTime? @map("air_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  season Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assets MediaAsset[]

  @@unique([seasonId, number], map: "uq_episode_number")
  @@index([seasonId, number], map: "idx_episodes_season")
  @@map("episodes")
}

model Genre {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String @unique @db.VarChar(50)
  name      String @db.VarChar(50)
  sortOrder Int    @default(0) @map("sort_order") @db.SmallInt

  titles TitleGenre[]

  @@map("genres")
}

model TitleGenre {
  titleId String @map("title_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([titleId, genreId])
  @@index([genreId], map: "idx_title_genres_genre")
  @@map("title_genres")
}

// ─── Media ───────────────────────────────────────────────────────────────────

/// The central table. Two nullable FKs with a CHECK, not a polymorphic
/// owner_type/owner_id pair — the database, not the application, guarantees
/// that no asset is ever orphaned (ADR-004).
model MediaAsset {
  id     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind   AssetKind
  status AssetStatus @default(UPLOADING)

  titleId   String? @map("title_id") @db.Uuid
  episodeId String? @map("episode_id") @db.Uuid

  sourceKey       String? @map("source_key")
  sourceSizeBytes BigInt? @map("source_size_bytes")
  sourceCodec     String? @map("source_codec") @db.VarChar(30)
  durationSec     Int?    @map("duration_sec")
  width           Int?    @db.SmallInt
  height          Int?    @db.SmallInt
  frameRate       Decimal? @map("frame_rate") @db.Decimal(6, 3)

  hlsMasterKey   String? @map("hls_master_key")
  previewClipKey String? @map("preview_clip_key")
  spriteKey      String? @map("sprite_key")
  spriteVttKey   String? @map("sprite_vtt_key")

  outputSizeBytes BigInt? @map("output_size_bytes")
  errorMessage    String? @map("error_message")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt   DateTime? @map("ready_at") @db.Timestamptz(6)

  title    Title?   @relation(fields: [titleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  episode  Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  renditions Rendition[]
  subtitles  SubtitleTrack[]
  jobs       TranscodeJob[]
  progress   WatchProgress[]

  @@map("media_assets")
}

model Rendition {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId      String  @map("asset_id") @db.Uuid
  height       Int     @db.SmallInt
  width        Int     @db.SmallInt
  bitrateKbps  Int     @map("bitrate_kbps")
  codec        String  @db.VarChar(20)
  playlistKey  String  @map("playlist_key")
  sizeBytes    BigInt? @map("size_bytes")

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assetId, height, codec], map: "uq_rendition")
  @@index([assetId], map: "idx_renditions_asset")
  @@map("renditions")
}

model SubtitleTrack {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId     String       @map("asset_id") @db.Uuid
  /// BCP-47: vi, en, en-US, ja.
  lang        String       @db.VarChar(10)
  label       String       @db.VarChar(50)
  kind        SubtitleKind @default(SUBTITLES)
  isDefault   Boolean      @default(false) @map("is_default")
  /// Original SRT/ASS, kept so edits do not need a re-upload.
  sourceKey   String?      @map("source_key")
  playlistKey String       @map("playlist_key")

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assetId, lang, kind], map: "uq_subtitle_lang")
  @@index([assetId], map: "idx_subtitles_asset")
  @@map("subtitle_tracks")
}

// ─── Personalisation ─────────────────────────────────────────────────────────

model WatchProgress {
  profileId   String   @map("profile_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  positionSec Int      @default(0) @map("position_sec")
  completed   Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([profileId, assetId])
  @@map("watch_progress")
}

model MyListItem {
  profileId String   @map("profile_id") @db.Uuid
  titleId   String   @map("title_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  title   Title   @relation(fields: [titleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([profileId, titleId])
  @@index([profileId, createdAt(sort: Desc)], map: "idx_mylist_profile")
  @@map("my_list")
}

// ─── Operations ──────────────────────────────────────────────────────────────

model TranscodeJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId      String    @map("asset_id") @db.Uuid
  bullJobId    String?   @map("bull_job_id") @db.VarChar(100)
  status       JobStatus @default(QUEUED)
  stage        String?   @db.VarChar(30)
  percent      Int       @default(0) @db.SmallInt
  attempt      Int       @default(1) @db.SmallInt
  encoder      String?   @db.VarChar(30)
  avgSpeed     Decimal?  @map("avg_speed") @db.Decimal(6, 2)
  /// Last 200 FFmpeg lines only — truncated in the worker before writing.
  logText      String?   @map("log_text")
  errorMessage String?   @map("error_message")
  queuedAt     DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assetId, queuedAt(sort: Desc)], map: "idx_jobs_asset")
  @@map("transcode_jobs")
}

/// Partitioned by month in the migration; Prisma sees a plain table.
model PlaybackEvent {
  id                 BigInt   @default(autoincrement())
  profileId          String   @map("profile_id") @db.Uuid
  assetId            String   @map("asset_id") @db.Uuid
  sessionId          String   @map("session_id") @db.Uuid
  startupTimeMs      Int?     @map("startup_time_ms")
  rebufferCount      Int      @default(0) @map("rebuffer_count") @db.SmallInt
  rebufferDurationMs Int      @default(0) @map("rebuffer_duration_ms")
  bitrateSwitches    Int      @default(0) @map("bitrate_switches") @db.SmallInt
  avgBitrateKbps     Int?     @map("avg_bitrate_kbps")
  watchedSec         Int?     @map("watched_sec")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@map("playback_events")
}

/// Object keys awaiting deletion from MinIO. Written BEFORE the Postgres rows
/// are dropped — the reverse order loses the only record of what to delete
/// (doc 04 §6).
model DeletionQueue {
  id         BigInt    @id @default(autoincrement())
  bucket     String    @db.VarChar(64)
  objectKey  String    @map("object_key")
  isPrefix   Boolean   @default(false) @map("is_prefix")
  attempts   Int       @default(0) @db.SmallInt
  lastError  String?   @map("last_error")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([deletedAt, createdAt], map: "idx_deletion_pending")
  @@map("deletion_queue")
}
